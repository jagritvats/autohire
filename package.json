{
  "name": "jobflow",
  "version": "0.1.0",
  "private": true,
  "description": "JobFlow — all-in-one job discovery, prep, and assisted-application platform (full TypeScript).",
  "type": "module",
  "homepage": "https://github.com/jagritvats/jobflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagritvats/jobflow.git"
  },
  "bugs": "https://github.com/jagritvats/jobflow/issues",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "setup": "pnpm install && pnpm -r build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "jobflow": "node apps/cli/bin/jobflow.mjs",
    "demo": "pnpm --filter @jobflow/cli demo",
    "dev": "pnpm --filter @jobflow/web dev",
    "web": "pnpm --filter @jobflow/web dev",
    "start": "pnpm --filter @jobflow/web start",
    "worker": "pnpm --filter @jobflow/worker runner",
    "agent": "pnpm --filter @jobflow/agent start",
    "mcp": "node apps/cli/bin/jobflow.mjs mcp",
    "db:migrate": "pnpm --filter @jobflow/db migrate",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f web worker",
    "docker:migrate": "docker compose run --rm migrate",
    "docker:rebuild": "docker compose build --no-cache",
    "screenshots": "pnpm --filter @jobflow/web build && node scripts/screenshots.mjs",
    "video": "node --import tsx scripts/video/make.mjs",
    "video:test": "node --test scripts/video/test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "1.60.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "AGPL-3.0-only",
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.32"
    }
  }
}
