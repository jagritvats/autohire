{
  "name": "jobflow",
  "version": "0.1.0",
  "private": true,
  "description": "JobFlow — all-in-one job discovery, prep, and assisted-application platform (full TypeScript).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "setup": "pnpm install && pnpm -r build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "ingest": "pnpm --filter @jobflow/cli ingest",
    "match": "pnpm --filter @jobflow/cli match",
    "demo": "pnpm --filter @jobflow/cli demo",
    "dev": "pnpm --filter @jobflow/web dev",
    "web": "pnpm --filter @jobflow/web dev",
    "start": "pnpm --filter @jobflow/web start",
    "worker": "pnpm --filter @jobflow/worker runner",
    "agent": "pnpm --filter @jobflow/agent start",
    "db:migrate": "pnpm --filter @jobflow/db migrate",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f web worker",
    "docker:migrate": "docker compose run --rm migrate",
    "docker:rebuild": "docker compose build --no-cache"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
