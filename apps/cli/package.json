{
  "name": "@jobflow/cli",
  "version": "0.1.0",
  "private": true,
  "description": "jobflow — the local-first JobFlow command line: search, rank, tailor, and fill applications up to the review screen.",
  "type": "module",
  "bin": {
    "jobflow": "./bin/jobflow.mjs"
  },
  "scripts": {
    "jobflow": "tsx src/main.ts",
    "demo": "tsx src/main.ts demo",
    "harvest": "tsx src/main.ts harvest",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jobflow/adapters": "workspace:*",
    "@jobflow/autofill": "workspace:*",
    "@jobflow/core": "workspace:*",
    "@jobflow/db": "workspace:*",
    "@jobflow/llm": "workspace:*",
    "@jobflow/pipeline": "workspace:*",
    "@jobflow/resume-io": "workspace:*",
    "@jobflow/service": "workspace:*",
    "commander": "^12.1.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "vitest": "^2.1.8"
  }
}
