# ─────────────────────────────────────────────────────────────
# JobFlow environment — copy to .env and fill in what you need.
# Nothing here is required to try JobFlow: every default works with no keys,
# no database and no paid service. Comments sit on their own lines on purpose —
# keep values bare (an inline "# note" after a value is a common .env pitfall).
# ─────────────────────────────────────────────────────────────

# ── Storage ──────────────────────────────────────────────────
# Where JobFlow keeps its data. Pick ONE:
#   • nothing set           → PGlite under JOBFLOW_DATA_DIR (~/.jobflow): durable, no
#                             server, SHARED by the jobflow CLI and the web app (one
#                             writer at a time — the web app syncs on a schedule itself)
#   • JOBFLOW_STORE=memory  → in-memory, gone when the process exits (demo/tests)
#   • JOBFLOW_STORE=pglite  → embedded Postgres (WASM) under JOBFLOW_DATA_DIR, no server
#   • DATABASE_URL=…        → your own Postgres + pgvector (wins over JOBFLOW_STORE)
# Docker (`pnpm docker:up`) sets DATABASE_URL for its containers itself. Its Postgres is
# published to THIS machine on 127.0.0.1:5433 (not 5432, to avoid clashing with a local
# Postgres) — to point the CLI or local agent at it use:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5433/jobflow
# A Postgres you run natively usually listens on 5432:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/jobflow
# Hosted Postgres (Supabase, Neon, RDS…): TLS follows sslmode — append ?sslmode=require
# (or verify-full with PGSSLROOTCERT). Without it the connection is NOT encrypted.
DATABASE_URL=
# memory | pglite | postgres
JOBFLOW_STORE=
# Data directory for PGlite, uploaded résumés and generated files (default ~/.jobflow).
# Docker mounts a named volume at /data for web + worker.
JOBFLOW_DATA_DIR=
# Optional Supabase project (only if you use Supabase instead of plain Postgres)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Accounts & access (web app) ──────────────────────────────
# none     → no login; the app only answers on loopback/same-origin (single user, local)
# password → email + password accounts (required before exposing the app on a network)
JOBFLOW_AUTH=none
# Secret for session cookies and for encrypting stored LLM API keys. Required with
# JOBFLOW_AUTH=password. Generate one: openssl rand -hex 32
JOBFLOW_SECRET_KEY=
# closed → only the first account (the owner) can sign up; open → anyone can
JOBFLOW_SIGNUP=closed
# The public base URL the app is served at (links, cookie scope), e.g. https://jobs.example.com
JOBFLOW_PUBLIC_URL=http://localhost:3000
# First-run profile: leave blank for a blank profile + onboarding. Set to 1 to start
# from the fictional "Alex Example" sample (demos, screenshots).
JOBFLOW_SAMPLE_PROFILE=

# ── LLM (generation, re-rank write-ups) — see packages/llm ───
# Provider: anthropic | openai | grok | echo (echo = offline stub, no network, no key)
LLM_PROVIDER=echo
# Model overrides. Leave blank to use the provider's defaults:
#   anthropic: cheap claude-haiku-5-5, strong claude-opus-5-5
#   openai:    cheap gpt-5-mini,       strong gpt-5
#   grok:      cheap grok-3-mini,      strong grok-4
LLM_MODEL_CHEAP=
LLM_MODEL_STRONG=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# off    → each user brings their own key in Settings (the operator's key above is never
#          used for other users' generation)
# shared → users without their own key use the operator's provider + key above
JOBFLOW_OPERATOR_LLM=off

# ── Free enrichment sources (Tier 1, optional keys) ──────────
# Adzuna: free tier, returns salary. Register at developer.adzuna.com.
# The same keys also switch on the Adzuna job-search discovery feed.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Optional discovery sources (each is a no-op until its key is set) ──
# Careerjet publisher API (free publisher account → API key)
CAREERJET_API_KEY=
# your public IP (Careerjet requires the searching user's IP); default 127.0.0.1
CAREERJET_USER_IP=
# JSearch — PAID (Google for Jobs index). Set ONE: OpenWeb Ninja key, or a RapidAPI key
JSEARCH_API_KEY=
JSEARCH_RAPIDAPI_KEY=
# spend guard: each feed target is called at most once per N hours (per process)
JSEARCH_MIN_HOURS=24

# ── Polling & discovery (cloud-safe worker) ──────────────────
# worker self-schedules discover → poll → rank every N hours; 0 = off
JOBFLOW_POLL_EVERY_HOURS=6
# between polls, re-check the top 40 cards' own job pages; a definitive 404/closed retires them; 0 = off
JOBFLOW_LIVENESS_EVERY_HOURS=2
# LLM re-rank write-ups for the top N matches (cached per posting; never with echo); 0 = off
JOBFLOW_RERANK_TOP=15
# country the big-employer boards (Workday/Eightfold/SmartRecruiters/Amazon) are polled for
JOBFLOW_POLL_COUNTRY=IN
# Telegram channels harvested for ATS links. Unset → the built-in default list;
# set it EMPTY to turn Telegram harvesting off.
# JOBFLOW_TELEGRAM_CHANNELS=gocareers,techuprise_updates,dot_aware

# ── Local agent (Tier 3 + form-fill) — all OFF by default (§7.1) ──
# The agent runs on YOUR machine (`pnpm agent`), never in Docker or the cloud.
# Its API token (create in Settings › API tokens, scope "agent"): picks whose jobs the
# agent drains. Blank with JOBFLOW_AUTH=none → the single local user.
JOBFLOW_AGENT_TOKEN=
# master kill switch (machine-level hard gate): off | on
JOBFLOW_BROWSER=off
# capture | fill   (fill = enable the form-filler; it never submits)
JOBFLOW_BROWSER_MODE=capture
# hard false; the form-filler has no submit path (invariant #2)
JOBFLOW_AUTOSUBMIT=false
# human (jittered pacing, no parallel sessions) | fast
JOBFLOW_RATE=human
# optional env allow-list (csv): naukri,linkedin,peerlist,wellfound,darwinbox,ambitionbox,glassdoor
JOBFLOW_TIER3_SOURCES=
# agent self-schedules each opted-in local source every N hours (only while the browser gates are on); 0 = off
JOBFLOW_LOCAL_POLL_EVERY_HOURS=12
# Chromium user-data dir the agent drives (your logged-in sessions). Default ~/.jobflow/browser-profile
JOBFLOW_BROWSER_PROFILE=

# Tier-3 poll targeting — all optional; unset → curated defaults. These only shape WHAT
# the local agent browses; the matcher still weights everything (never a hard filter).
# csv override, e.g. backend engineer,platform engineer,sde
JOBFLOW_TIER3_QUERIES=
# csv hubs, e.g. bengaluru,pune,hyderabad (blank includes a remote pass)
JOBFLOW_TIER3_LOCATIONS=
# soft CTC floor in LPA (lakhs/annum), e.g. 20 (default: from the profile's salary floor)
JOBFLOW_TIER3_MIN_LPA=
# recency window in days, e.g. 15
JOBFLOW_TIER3_FRESHNESS_DAYS=
# cards per (query × location) cell, e.g. 25
JOBFLOW_TIER3_LIMIT=
# politeness cap on total cells per browse, e.g. 8
JOBFLOW_TIER3_MAX_TARGETS=
# Full local-agent enablement steps: docs/SETUP.md

# ── Docker only ──────────────────────────────────────────────
# Host address the web container is published on. 127.0.0.1 = this machine only.
# Use 0.0.0.0 to expose it on your network — only together with JOBFLOW_AUTH=password.
JOBFLOW_WEB_BIND=127.0.0.1
# 0 = skip the TeX install in the web image (smaller; .tex download fallback still works)
INSTALL_LATEX=1

# ── Misc ─────────────────────────────────────────────────────
NODE_ENV=development
# default single-tenant id
TENANT_ID=00000000-0000-0000-0000-000000000001

# AGPL-3.0 §13: the web app's footer links to its source. If you serve a MODIFIED version to
# other people, point this at where your modified source is published.
JOBFLOW_SOURCE_URL=
