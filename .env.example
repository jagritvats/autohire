# ─────────────────────────────────────────────────────────────
# JobFlow environment — copy to .env and fill in. v1 needs nothing
# paid; the ATS/aggregator/HN sources below require no keys at all.
# ─────────────────────────────────────────────────────────────

# --- Database (Supabase Postgres + pgvector) ---
# Local demo / CLI works without these (in-memory repo). Set for persistence.
# Docker (`pnpm docker:up`): compose sets DATABASE_URL to its own `db` service and
# maps it to localhost:5433 — point the local agent at postgres://postgres:postgres@localhost:5433/jobflow.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobflow
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (swappable per task; see packages/llm) ---
# Provider: anthropic | grok | openai | echo (echo = no-network stub for dev)
LLM_PROVIDER=echo
LLM_MODEL_CHEAP=claude-haiku-4-5-20251001
LLM_MODEL_STRONG=claude-opus-4-8
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# --- Free enrichment sources (Tier 1, optional keys) ---
# Adzuna: free tier, returns salary. Register at developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Local agent (Tier 3) — flag-guarded, all OFF by default (§7.1) ---
JOBFLOW_BROWSER=off                 # master kill switch (machine-level hard gate): off | on
JOBFLOW_BROWSER_MODE=capture        # capture | fill   (fill = enable form-filler; never autosubmit)
JOBFLOW_AUTOSUBMIT=false            # hard false; flipping requires code change + per-app opt-in
JOBFLOW_RATE=human                  # human pacing, jittered; no parallel sessions
JOBFLOW_TIER3_SOURCES=              # optional env allow-list (csv): naukri,ambitionbox,glassdoor,linkedin
JOBFLOW_BROWSER_PROFILE=            # Chromium user-data dir the agent drives (logged into LinkedIn/Naukri)

# Tier-3 poll targeting — the "good-paying software/engineering in India" sweep.
# All optional: unset → curated defaults (INDIA_SWE_QUERIES × Indian tech hubs). These
# only shape WHAT the local agent browses; the matcher still weights everything (not a
# hard filter). minLpa defaults to your profile's INR salary floor expressed in LPA.
JOBFLOW_TIER3_QUERIES=              # csv override, e.g. "backend engineer,platform engineer,sde"
JOBFLOW_TIER3_LOCATIONS=            # csv India hubs, e.g. "bengaluru,pune,hyderabad" (blank incl. a remote pass)
JOBFLOW_TIER3_MIN_LPA=              # soft CTC floor in LPA (lakhs/annum), e.g. 20  (default: from profile floor)
JOBFLOW_TIER3_FRESHNESS_DAYS=       # recency window, e.g. 15
JOBFLOW_TIER3_LIMIT=                # cards per (query × location) cell, e.g. 25
JOBFLOW_TIER3_MAX_TARGETS=          # politeness cap on total cells per browse, e.g. 8
# Full local-agent enablement steps: see docs/SETUP.md

# --- Misc ---
NODE_ENV=development
TENANT_ID=00000000-0000-0000-0000-000000000001   # default single-tenant id
